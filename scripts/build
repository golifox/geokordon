#!/usr/bin/env bash
# Build dist/geokordon: the entry point with its modules and units inlined.
#   scripts/build [OUT]   OUT defaults to dist/geokordon; - writes to stdout
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$ROOT/dist/geokordon}"
# The front sends the program gzipped in base64 inside one ssh command line; Linux limits
# one argument to 128 KB.
MAX_PAYLOAD=98304

bundle() {
	local line in_sources="" file unit
	while IFS= read -r line; do
		case "$line" in
		'# >>> sources'*)
			in_sources=1
			echo "GEOKORDON_BUNDLED=1"
			;;
		'# <<< sources'*)
			in_sources=""
			echo "unit_text() {"
			# shellcheck disable=SC2016 # Code for the bundle.
			echo '	case "$1" in'
			for unit in "$ROOT"/units/*; do
				echo "	$(basename "$unit"))"
				echo "		cat <<'UNIT_EOF'"
				cat "$unit"
				echo "UNIT_EOF"
				echo "		;;"
			done
			echo "	esac"
			echo "}"
			;;
		*)
			if [ -z "$in_sources" ]; then
				echo "$line"
			elif [[ "$line" =~ ^source\ \"\$GEOKORDON_ROOT/(lib/[a-z]+\.sh)\"$ ]]; then
				file="$ROOT/${BASH_REMATCH[1]}"
				echo "# --- ${BASH_REMATCH[1]}"
				grep -v '^# shellcheck shell=bash$' "$file"
			fi
			;;
		esac
	done <"$ROOT/geokordon"
}

text="$(bundle)"
size="$(printf '%s\n' "$text" | gzip -9 | base64 | tr -d '\n' | wc -c | tr -d ' ')"
[ "$size" -le "$MAX_PAYLOAD" ] || {
	echo "bundle too large for one ssh command: $size bytes of base64, limit $MAX_PAYLOAD" >&2
	exit 1
}

if [ "$OUT" = - ]; then
	printf '%s\n' "$text"
else
	mkdir -p "$(dirname "$OUT")"
	printf '%s\n' "$text" >"$OUT.new"
	chmod 755 "$OUT.new"
	mv "$OUT.new" "$OUT"
	echo "built $OUT ($size bytes to send)"
fi
