#!/usr/bin/env bash
# Rebuilds the nftables table geokordon: drop RU sources except SSH and Amnezia ports,
# reject forwarded connections to RU destinations. Installed to /usr/local/sbin/geokordon-update.
set -euo pipefail

PORTS=/etc/geokordon.ports
ALLOW=/etc/geokordon.allow
CACHE=/var/lib/geokordon
mkdir -p "$CACHE"

V4_PREFIX='^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$'
V6_PREFIX='^[0-9a-f:]+/[0-9]{1,3}$'

# count_prefixes FILE REGEX: the number of lines, or nothing when a non-empty line does not match.
# grep, not awk: Debian's mawk has no {n,m} intervals.
count_prefixes() {
	if ! grep -v '^$' "$1" | grep -qvE "$2"; then
		grep -cE "$2" "$1" || true
	fi
}

# fetch URL FILE REGEX MIN: replace FILE with the download only when every line is a prefix
# and there are at least MIN of them and at least half of the cached count: a truncated or
# altered answer must not narrow the block silently.
fetch() {
	local url="$1" file="$2" re="$3" min="$4" count old=0
	if ! curl -fsS --retry 5 --retry-connrefused --retry-delay 5 -m 120 "$url" -o "$file.new"; then
		rm -f "$file.new"
		echo "download failed: $url (using cached list if any)" >&2
		return
	fi
	count="$(count_prefixes "$file.new" "$re")"
	if [ -f "$file" ]; then old="$(count_prefixes "$file" "$re")"; fi
	if [ -n "$count" ] && [ "$count" -ge "$min" ] && [ $((count * 2)) -ge "${old:-0}" ]; then
		mv "$file.new" "$file"
	else
		rm -f "$file.new"
		echo "rejected $url: ${count:-malformed} prefixes, need $min and half of the cached ${old:-0} (using cached list if any)" >&2
	fi
}

fetch https://www.ipdeny.com/ipblocks/data/aggregated/ru-aggregated.zone "$CACHE/ru4.zone" "$V4_PREFIX" 1000
fetch https://www.ipdeny.com/ipv6/ipaddresses/aggregated/ru-aggregated.zone "$CACHE/ru6.zone" "$V6_PREFIX" 200

[ -s "$CACHE/ru4.zone" ] || {
	echo "no RU IPv4 list, nothing applied" >&2
	exit 1
}
v4="$(awk 'NF' "$CACHE/ru4.zone" | paste -sd, -)"
v6="$(awk 'NF' "$CACHE/ru6.zone" 2>/dev/null | paste -sd, - || true)"

# Allowed ports accumulate: SSH from sshd config and listeners, Amnezia from its containers.
{
	cat "$PORTS" 2>/dev/null || true
	sshd -T 2>/dev/null | awk '$1 == "port" { print "tcp " $2 }' || true
	ss -Htlnp 2>/dev/null | awk '/"sshd"/ { n = split($4, a, ":"); print "tcp " a[n] }' || true
	if command -v docker >/dev/null; then
		docker ps --format '{{.Names}} {{.Ports}}' 2>/dev/null |
			awk '$1 ~ /^amnezia/' |
			grep -oE ':[0-9]+->[0-9]+/(tcp|udp)' |
			sed -E 's#^:([0-9]+)->[0-9]+/(tcp|udp)$#\2 \1#' || true
	fi
} | grep -E '^(tcp|udp) [0-9]+$' | sort -u >"$PORTS.new"
mv "$PORTS.new" "$PORTS"

# Direct list: neither blocked nor sent through WARP. Host names resolve on every run,
# so a changed IP is picked up by the daily refresh.
# Same rules as allow_check in lib/allow.sh: an address has dots and digits only or a colon,
# so a host name made of hex letters (bbc.de) resolves instead of reaching nft as is.
IPV4_OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
IPV4="^$IPV4_OCTET(\.$IPV4_OCTET){3}(/([0-9]|[12][0-9]|3[0-2]))?$"
IPV6='^[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*(/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))?$'
HOST_LABEL='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
HOST="^($HOST_LABEL\.)*$HOST_LABEL$"

resolve_allow() {
	local entry
	[ -f "$ALLOW" ] || return 0
	while read -r entry; do
		case "$entry" in '' | '#'*) continue ;; esac
		if [[ "$entry" =~ $IPV4 || "$entry" =~ $IPV6 ]]; then
			echo "$entry"
		elif [[ "$entry" =~ $HOST && ! "$entry" =~ ^[0-9.]+$ ]]; then
			getent ahosts "$entry" | awk '{ print $1 }' || echo "cannot resolve $entry" >&2
		else
			echo "skipped, not a host, IP or subnet: $entry" >&2
		fi
	done <"$ALLOW"
}
resolve_allow | sort -u >"$CACHE/allow.resolved.new"
allow4="$(awk '/^[0-9.]+(\/[0-9]+)?$/' "$CACHE/allow.resolved.new" | paste -sd, -)"
allow6="$(awk '/:/' "$CACHE/allow.resolved.new" | paste -sd, -)"

tcp="$(awk '$1 == "tcp" { print $2 }' "$PORTS" | paste -sd, -)"
udp="$(awk '$1 == "udp" { print $2 }' "$PORTS" | paste -sd, -)"

nft_file="$CACHE/geokordon.nft"
{
	echo "table inet geokordon"
	echo "delete table inet geokordon"
	echo "table inet geokordon {"
	echo "  set ru4 { type ipv4_addr; flags interval; auto-merge; elements = { $v4 } }"
	if [ -n "$v6" ]; then
		echo "  set ru6 { type ipv6_addr; flags interval; auto-merge; elements = { $v6 } }"
	fi
	if [ -n "$allow4" ]; then
		echo "  set allow4 { type ipv4_addr; flags interval; auto-merge; elements = { $allow4 } }"
	fi
	if [ -n "$allow6" ]; then
		echo "  set allow6 { type ipv6_addr; flags interval; auto-merge; elements = { $allow6 } }"
	fi
	echo "  chain prerouting {"
	# Before Docker DNAT, so published container ports are covered too.
	echo "    type filter hook prerouting priority -150; policy accept;"
	echo "    ct state established,related accept"
	echo "    iifname \"lo\" accept"
	if [ -n "$allow4" ]; then echo "    ip saddr @allow4 accept"; fi
	if [ -n "$allow6" ]; then echo "    ip6 saddr @allow6 accept"; fi
	if [ -n "$tcp" ]; then echo "    tcp dport { $tcp } accept"; fi
	if [ -n "$udp" ]; then echo "    udp dport { $udp } accept"; fi
	echo "    ip saddr @ru4 drop"
	if [ -n "$v6" ]; then echo "    ip6 saddr @ru6 drop"; fi
	echo "  }"
	echo "  chain forward {"
	# VPN clients must not reach RU destinations through this server.
	# Only connections initiated towards RU; replies to RU clients stay allowed.
	# TCP gets a reset: macOS and other BSD stacks ignore ICMP unreachable while connecting
	# and would hang until timeout.
	echo "    type filter hook forward priority -10; policy accept;"
	if [ -n "$allow4" ]; then echo "    ip daddr @allow4 accept"; fi
	if [ -n "$allow6" ]; then echo "    ip6 daddr @allow6 accept"; fi
	echo "    ct direction original ip daddr @ru4 meta l4proto tcp reject with tcp reset"
	echo "    ct direction original ip daddr @ru4 reject"
	if [ -n "$v6" ]; then
		echo "    ct direction original ip6 daddr @ru6 meta l4proto tcp reject with tcp reset"
		echo "    ct direction original ip6 daddr @ru6 reject"
	fi
	echo "  }"
	echo "}"
} >"$nft_file.new"

# geokordon-restore.service loads the cached file on boot, so only a checked one replaces it.
nft -c -f "$nft_file.new" || {
	rm -f "$nft_file.new" "$CACHE/allow.resolved.new"
	echo "generated rules rejected by nft, the current ones stay" >&2
	exit 1
}
mv "$nft_file.new" "$nft_file"
mv "$CACHE/allow.resolved.new" "$CACHE/allow.resolved"
nft -f "$nft_file"
# WARP keeps the direct list out of its marks; rebuild it with the fresh addresses.
if systemctl is-active --quiet geokordon-warp.service; then
	/usr/local/sbin/geokordon-warp up
fi
echo "geokordon applied: open for RU -> tcp {$tcp} udp {$udp}"
