#!/usr/bin/env bash
# Close a VPN exit server to Russian IP ranges (Debian/Ubuntu, root or a sudo user over SSH):
#  - VPN clients cannot reach RU destinations through the server (forwarded traffic is rejected);
#  - inbound from RU is dropped except SSH and Amnezia VPN ports, which stay open for everyone.
# Ranges come from ipdeny.com and refresh daily through a systemd timer on the server.
#
# Usage: ./ru-block [install|remove]
# Asks for the server IP, SSH port (default 22), user (default root) and password; an empty
# password uses SSH keys. A user other than root runs the setup through sudo with the same password.
set -euo pipefail

ACTION="${1:-install}"
case "$ACTION" in
install | remove) ;;
*)
	echo "Usage: $0 [install|remove]" >&2
	exit 1
	;;
esac

read -r -p "Server IP: " server
[ -n "$server" ] || {
	echo "Server IP is required" >&2
	exit 1
}
read -r -p "SSH port [22]: " ssh_port
ssh_port="${ssh_port:-22}"
[[ "$ssh_port" =~ ^[0-9]+$ ]] || {
	echo "SSH port must be a number" >&2
	exit 1
}
read -r -p "SSH user [root]: " ssh_user
ssh_user="${ssh_user:-root}"
read -r -s -p "Password (empty for SSH keys): " password
echo

ssh_opts=(-p "$ssh_port" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15)

if [ -n "$password" ]; then
	askpass="$(mktemp)"
	trap 'rm -f "$askpass"' EXIT
	# shellcheck disable=SC2016 # $RU_BLOCK_PASSWORD expands when ssh runs the helper.
	printf '#!/bin/sh\nprintf "%%s\\n" "$RU_BLOCK_PASSWORD"\n' >"$askpass"
	chmod 700 "$askpass"
	export RU_BLOCK_PASSWORD="$password" SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-:0}"
else
	# Key mode: check the login and passwordless sudo up front, so a failure explains its fix.
	check="true"
	[ "$ssh_user" = root ] || check="sudo -n true"
	status=0
	# shellcheck disable=SC2029 # The check command is built locally on purpose.
	ssh -n -o BatchMode=yes "${ssh_opts[@]}" "$ssh_user@$server" "$check" 2>/dev/null || status=$?
	if [ "$status" = 255 ]; then
		cat >&2 <<EOF
Cannot log in to $ssh_user@$server (port $ssh_port) with an SSH key.
Fix one of:
  - run again and enter the password;
  - add your key to the server: ssh-copy-id -p $ssh_port $ssh_user@$server
EOF
		exit 1
	elif [ "$status" != 0 ]; then
		cat >&2 <<EOF
$ssh_user cannot run sudo without a password on $server.
Fix one of:
  - run again and enter the password of $ssh_user;
  - run again with SSH user root;
  - allow passwordless sudo, on the server:
      echo '$ssh_user ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/$ssh_user && sudo chmod 440 /etc/sudoers.d/$ssh_user
EOF
		exit 1
	fi
fi

# Runs on the server as root; arguments: ACTION, the SSH port we connect through.
IFS= read -r -d '' remote_script <<'REMOTE' || true
set -euo pipefail
ACTION="$1"
CLIENT_SSH_PORT="$2"

[ "$(id -u)" = 0 ] || { echo "Needs root or sudo" >&2; exit 1; }

if [ "$ACTION" = remove ]; then
  systemctl disable --now ru-block.timer 2>/dev/null || true
  nft delete table inet ru_block 2>/dev/null || true
  rm -f /etc/systemd/system/ru-block.service /etc/systemd/system/ru-block.timer \
        /usr/local/sbin/ru-block-update /etc/ru-block.ports
  rm -rf /var/lib/ru-block
  systemctl daemon-reload
  echo "ru-block removed"
  exit 0
fi

if ! command -v nft >/dev/null || ! command -v curl >/dev/null; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nftables curl
fi

# The port we are connected through always stays open.
echo "tcp $CLIENT_SSH_PORT" >> /etc/ru-block.ports

cat > /usr/local/sbin/ru-block-update <<'EOF'
#!/usr/bin/env bash
# Rebuilds the nftables table ru_block: drop RU sources except SSH and Amnezia ports,
# reject forwarded connections to RU destinations.
set -euo pipefail

PORTS=/etc/ru-block.ports
CACHE=/var/lib/ru-block
mkdir -p "$CACHE"

fetch() {
  if curl -fsS --retry 5 --retry-connrefused --retry-delay 5 -m 120 "$1" -o "$2.new" \
     && grep -qE '^[0-9a-f]' "$2.new"; then
    mv "$2.new" "$2"
  else
    rm -f "$2.new"
    echo "download failed: $1 (using cached list if any)" >&2
  fi
}

fetch https://www.ipdeny.com/ipblocks/data/aggregated/ru-aggregated.zone "$CACHE/ru4.zone"
fetch https://www.ipdeny.com/ipv6/ipaddresses/aggregated/ru-aggregated.zone "$CACHE/ru6.zone"

[ -s "$CACHE/ru4.zone" ] || { echo "no RU IPv4 list, nothing applied" >&2; exit 1; }
v4="$(grep -E '^[0-9]' "$CACHE/ru4.zone" | paste -sd, -)"
v6="$(grep -E '^[0-9a-f]' "$CACHE/ru6.zone" 2>/dev/null | paste -sd, - || true)"

# Allowed ports accumulate: SSH from sshd config and listeners, Amnezia from its containers.
{
  cat "$PORTS" 2>/dev/null || true
  sshd -T 2>/dev/null | awk '$1 == "port" { print "tcp " $2 }' || true
  ss -Htlnp 2>/dev/null | awk '/"sshd"/ { n = split($4, a, ":"); print "tcp " a[n] }' || true
  if command -v docker >/dev/null; then
    docker ps --format '{{.Names}} {{.Ports}}' 2>/dev/null \
      | awk '$1 ~ /^amnezia/' \
      | grep -oE ':[0-9]+->[0-9]+/(tcp|udp)' \
      | sed -E 's#^:([0-9]+)->[0-9]+/(tcp|udp)$#\2 \1#' || true
  fi
} | grep -E '^(tcp|udp) [0-9]+$' | sort -u > "$PORTS.new"
mv "$PORTS.new" "$PORTS"

tcp="$(awk '$1 == "tcp" { print $2 }' "$PORTS" | paste -sd, -)"
udp="$(awk '$1 == "udp" { print $2 }' "$PORTS" | paste -sd, -)"

nft_file="$CACHE/ru-block.nft"
{
  echo "table inet ru_block"
  echo "delete table inet ru_block"
  echo "table inet ru_block {"
  echo "  set ru4 { type ipv4_addr; flags interval; auto-merge; elements = { $v4 } }"
  if [ -n "$v6" ]; then
    echo "  set ru6 { type ipv6_addr; flags interval; auto-merge; elements = { $v6 } }"
  fi
  echo "  chain prerouting {"
  # Before Docker DNAT, so published container ports are covered too.
  echo "    type filter hook prerouting priority -150; policy accept;"
  echo "    ct state established,related accept"
  echo "    iifname \"lo\" accept"
  if [ -n "$tcp" ]; then echo "    tcp dport { $tcp } accept"; fi
  if [ -n "$udp" ]; then echo "    udp dport { $udp } accept"; fi
  echo "    ip saddr @ru4 drop"
  if [ -n "$v6" ]; then echo "    ip6 saddr @ru6 drop"; fi
  echo "  }"
  echo "  chain forward {"
  # VPN clients must not reach RU destinations through this server.
  # Only connections initiated towards RU; replies to RU clients stay allowed.
  echo "    type filter hook forward priority -10; policy accept;"
  echo "    ct direction original ip daddr @ru4 reject"
  if [ -n "$v6" ]; then echo "    ct direction original ip6 daddr @ru6 reject"; fi
  echo "  }"
  echo "}"
} > "$nft_file"

nft -f "$nft_file"
echo "ru-block applied: open for RU -> tcp {$tcp} udp {$udp}"
EOF
chmod 755 /usr/local/sbin/ru-block-update

cat > /etc/systemd/system/ru-block.service <<'EOF'
[Unit]
Description=Block RU IP ranges on a VPN exit server
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ru-block-update
EOF

cat > /etc/systemd/system/ru-block.timer <<'EOF'
[Unit]
Description=Apply on boot and refresh RU IP ranges daily

[Timer]
OnBootSec=1min
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
/usr/local/sbin/ru-block-update
systemctl enable --now ru-block.timer >/dev/null
echo "IPv4 ranges loaded: $(nft list set inet ru_block ru4 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' | wc -l)"
REMOTE

# The script travels as an argument, so stdin stays free for the sudo password.
encoded="$(printf '%s' "$remote_script" | base64 | tr -d '\n')"
run="bash -c \"\$(echo $encoded | base64 -d)\" ru-block $ACTION $ssh_port"

# shellcheck disable=SC2029 # The command is built locally on purpose.
if [ "$ssh_user" = root ]; then
	ssh -n "${ssh_opts[@]}" "root@$server" "$run"
elif [ -n "$password" ]; then
	printf '%s\n' "$password" | ssh "${ssh_opts[@]}" "$ssh_user@$server" "sudo -S -p '' $run"
else
	ssh -n "${ssh_opts[@]}" "$ssh_user@$server" "sudo -n $run"
fi
