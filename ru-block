#!/usr/bin/env bash
# Close an Amnezia VPN exit server to Russian IP ranges, optionally route its traffic through WARP.
#
# Usage: ./ru-block [install | remove | warp on | warp off | allow]
# Asks for the server IP, SSH port (default 22), user (default root) and password; an empty
# password uses SSH keys. A user other than root runs everything through sudo.
#
# The direct list (hosts, IPs and subnets that skip the geoblock and WARP) is read from
# allow.list next to this script, or from $RU_BLOCK_ALLOW; install and allow send it to the server.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ALLOW_LIST="${RU_BLOCK_ALLOW:-$ROOT/allow.list}"
source "$ROOT/lib/ssh.sh"

usage() {
	echo "Usage: $0 [install | remove | warp on | warp off | allow]" >&2
	exit 1
}

case "${1:-install}" in
install | remove | allow) args=("${1:-install}") ;;
warp)
	[[ "${2:-}" =~ ^(on|off)$ ]] || usage
	args=(warp "$2")
	;;
*) usage ;;
esac

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT
mkdir "$WORK_DIR/remote"
cp -R "$ROOT/remote/." "$WORK_DIR/remote/"

# allow.list: one host, IP or subnet per line, # starts a comment.
if [ -f "$ALLOW_LIST" ]; then
	sed -e 's/#.*//' -e 's/[[:space:]]//g' "$ALLOW_LIST" | awk 'NF' >"$WORK_DIR/remote/allow.list"
	while read -r entry; do
		[[ "$entry" =~ ^[0-9A-Za-z.:-]+(/[0-9]{1,3})?$ ]] || {
			echo "$ALLOW_LIST: not a host, IP or subnet: $entry" >&2
			exit 1
		}
	done <"$WORK_DIR/remote/allow.list"
elif [ "${args[0]}" = allow ]; then
	echo "No $ALLOW_LIST: copy allow.list.example and fill it in" >&2
	exit 1
fi

ssh_prompt
ssh_prepare
ssh_run_remote "$WORK_DIR/remote" "${args[@]}"
