#!/usr/bin/env bash
# Close an Amnezia VPN exit server to Russian IP ranges, optionally route its traffic through WARP.
#
# Usage: ./geokordon COMMAND
#   install [--with-warp | --without-warp]
#                         install or update the geoblock (sends allow.list too), then switch
#                         WARP on or off; without a flag WARP stays as it is
#   warp on | warp off    route Amnezia traffic through Cloudflare WARP, or back to direct
#   allow add ENTRY...    add hosts, IPs or subnets to allow.list, then sync
#   allow del ENTRY...    remove them from allow.list, then sync
#   allow sync            send allow.list to the server
#   allow list            show the direct list on the server
#   remove                remove everything
# Asks for the server IP, SSH port (default 22), user (default root) and password; an empty
# password uses SSH keys. A user other than root runs everything through sudo.
#
# allow.list (next to this script, or $GEOKORDON_ALLOW) holds the direct list: entries that
# skip the geoblock and WARP.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ALLOW_LIST="${GEOKORDON_ALLOW:-$ROOT/allow.list}"
source "$ROOT/lib/ssh.sh"
source "$ROOT/lib/allow.sh"

usage() {
	sed -n 's/^#   //p' "$ROOT/geokordon" | sed 's/^/  /' >&2
	exit 1
}

case "${1:-install}" in
install)
	args=(install)
	if [ $# -gt 1 ]; then
		[[ "$2" =~ ^--with(out)?-warp$ ]] || usage
		args+=("$2")
	fi
	;;
remove) args=(remove) ;;
warp)
	[[ "${2:-}" =~ ^(on|off)$ ]] || usage
	args=(warp "$2")
	;;
allow)
	case "${2:-}" in
	sync | list) args=(allow "$2") ;;
	add | del)
		[ $# -gt 2 ] || usage
		allow_check "${@:3}"
		"allow_local_$2" "${@:3}"
		args=(allow sync)
		;;
	*) usage ;;
	esac
	;;
*) usage ;;
esac

if [ "${args[*]}" = "allow sync" ] && [ ! -f "$ALLOW_LIST" ]; then
	echo "No $ALLOW_LIST: copy allow.list.example or use allow add" >&2
	exit 1
fi

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT
mkdir "$WORK_DIR/remote"
cp -R "$ROOT/remote/." "$WORK_DIR/remote/"
if [ -f "$ALLOW_LIST" ]; then
	entries=()
	while IFS= read -r entry; do entries+=("$entry"); done < <(allow_entries)
	allow_check ${entries[@]+"${entries[@]}"}
	allow_entries >"$WORK_DIR/remote/allow.list"
fi

ssh_prompt
ssh_prepare
ssh_run_remote "$WORK_DIR/remote" "${args[@]}"
