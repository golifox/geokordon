#!/usr/bin/env bash
# geokordon: close a VPN exit server to Russian IP ranges, optionally route its containers
# through Cloudflare WARP. One file is both the server program and the front: with a
# target it runs itself on that server over ssh.
set -euo pipefail

GEOKORDON_VERSION=0.4.0
GEOKORDON_SELF="${BASH_SOURCE[0]}"

# >>> sources: scripts/build puts the modules and units here.
GEOKORDON_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$GEOKORDON_ROOT/lib/common.sh"
# shellcheck source=lib/allow.sh
source "$GEOKORDON_ROOT/lib/allow.sh"
# shellcheck source=lib/update.sh
source "$GEOKORDON_ROOT/lib/update.sh"
# shellcheck source=lib/warp.sh
source "$GEOKORDON_ROOT/lib/warp.sh"
# shellcheck source=lib/install.sh
source "$GEOKORDON_ROOT/lib/install.sh"
# shellcheck source=lib/status.sh
source "$GEOKORDON_ROOT/lib/status.sh"
# shellcheck source=lib/remove.sh
source "$GEOKORDON_ROOT/lib/remove.sh"
# shellcheck source=lib/front.sh
source "$GEOKORDON_ROOT/lib/front.sh"
unit_text() { cat "$GEOKORDON_ROOT/units/$1"; }
# <<< sources

usage() {
	cat <<'EOF'
Usage: geokordon [-H TARGET] [-p PORT] COMMAND

Commands:
  install [--with-warp | --without-warp]
                         install or update; then switch WARP on or off (without a flag
                         WARP stays as it is)
  update                 download the RU ranges and apply the rules now
  status                 what is installed and applied
  warp on | warp off     route the VPN containers through Cloudflare WARP, or back to direct
  allow add ENTRY...     add hosts, IPs or subnets to the direct list (no geoblock, no WARP)
  allow del ENTRY...     remove them
  allow list             show the direct list and its addresses
  allow push FILE        replace the direct list with FILE
  allow pull             print the direct list as a file for allow push
  remove                 remove everything, this program included

Options:
  -H TARGET              run on TARGET over ssh: user@host or an alias from ~/.ssh/config;
                         repeat it to run on several servers in turn (default
                         $GEOKORDON_HOST, space-separated); without it the command runs here
  -p PORT                ssh port
  -h, --help             this help
  --version              print the version

On Linux the command runs locally as root. Elsewhere without a target it asks for one.
EOF
}

usage_error() {
	usage >&2
	exit 2
}

# command_valid ARGS...: the command line is one of usage.
command_valid() {
	case "$1" in
	install) [ $# = 1 ] || { [ $# = 2 ] && [[ "$2" =~ ^--with(out)?-warp$ ]]; } ;;
	update | status | remove) [ $# = 1 ] ;;
	# up, down and disable are for geokordon-warp.service and the rollback timer.
	warp) [ $# = 2 ] && [[ "$2" =~ ^(on|off|up|down|disable)$ ]] ;;
	allow)
		case "${2:-}" in
		add | del) [ $# -gt 2 ] ;;
		list | pull) [ $# = 2 ] ;;
		push) [ $# = 3 ] ;;
		*) false ;;
		esac
		;;
	*) false ;;
	esac
}

# core_run ARGS...: the command on this machine, as root.
core_run() {
	need_root
	# ssh forwards the local locale, which the server may not have.
	export LANG=C.UTF-8 LC_ALL=C.UTF-8
	# A root login over ssh without sudo may lack sbin (nft, sshd, sysctl).
	export PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH"
	case "$1 ${2:-}" in
	"warp up" | "warp down" | "warp disable") ;;
	status* | "allow list" | "allow pull") ;;
	remove*) lock ;;
	*)
		lock
		self_sync
		;;
	esac
	case "$1" in
	install) cmd_install "${2:-}" ;;
	update) cmd_update ;;
	status) cmd_status ;;
	warp) cmd_warp "$2" ;;
	allow) cmd_allow "${@:2}" ;;
	remove) cmd_remove ;;
	esac
}

main() {
	local targets=() target port=""
	while [ $# -gt 0 ]; do
		case "$1" in
		-H)
			[ $# -ge 2 ] || usage_error
			targets+=("$2")
			shift 2
			;;
		-p)
			[[ "${2:-}" =~ ^[0-9]+$ ]] || usage_error
			port="$2"
			shift 2
			;;
		-h | --help)
			usage
			exit 0
			;;
		--version)
			echo "geokordon $GEOKORDON_VERSION"
			exit 0
			;;
		-*) usage_error ;;
		*) break ;;
		esac
	done
	if [ $# = 0 ] || ! command_valid "$@"; then usage_error; fi
	# GEOKORDON_HOST may hold several targets, separated by spaces.
	if [ ${#targets[@]} = 0 ] && [ -n "${GEOKORDON_HOST:-}" ]; then
		read -r -a targets <<<"$GEOKORDON_HOST"
	fi

	if [ ${#targets[@]} = 0 ] && [ "$(uname -s)" != Linux ]; then
		[ -t 0 ] || die "No target: pass -H user@host or set GEOKORDON_HOST"
		read -r -p "Server (user@host or ssh alias): " target
		[ -n "$target" ] || die "A target is required"
		targets=("$target")
	fi
	if [ ${#targets[@]} -gt 1 ] && [ "$1 ${2:-}" = "allow pull" ]; then
		die "allow pull reads one server: pass one -H"
	fi
	if [ ${#targets[@]} -gt 0 ]; then
		front_each "$port" ${#targets[@]} "${targets[@]}" "$@"
	else
		core_run "$@"
	fi
}

# Sourced by the tests: functions only.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
